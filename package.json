{
  "name": "ridewithme",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --filter @rwm/web dev",
    "dev:admin": "pnpm --filter @rwm/admin dev",
    "dev:mobile": "pnpm --filter @rwm/mobile start",
    "build:web": "pnpm --filter @rwm/web build",
    "build:admin": "pnpm --filter @rwm/admin build",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
