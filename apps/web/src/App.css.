* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #0f1115;
  color: #f2f2f2;
}

.app {
  max-width: 1100px;
  margin: 0 auto;
  padding: 20px;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.header h1 {
  margin: 0;
  font-size: 1.6rem;
  color: #e63946;
}

.search {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid #2a2d34;
  background: #1a1d23;
  color: #f2f2f2;
  font-size: 1rem;
}

.tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin-bottom: 20px;
}

.tab {
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid #2a2d34;
  background: #1a1d23;
  color: #ccc;
  cursor: pointer;
  white-space: nowrap;
  font-size: 0.9rem;
}

.tab.active {
  background: #e63946;
  border-color: #e63946;
  color: white;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
}

.vehicle-card {
  background: #1a1d23;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid #2a2d34;
}

.vehicle-card img {
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.vehicle-info {
  padding: 12px;
}

.vehicle-info h3 {
  margin: 0 0 6px;
  font-size: 1rem;
}

.price {
  font-weight: 600;
  color: #e63946;
  margin: 0 0 4px;
}

.meta {
  font-size: 0.8rem;
  color: #999;
  margin: 0 0 8px;
}

.badge {
  display: inline-block;
  font-size: 0.7rem;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 999px;
  background: #2a2d34;
  color: #ccc;
}

.empty {
  grid-column: 1 / -1;
  text-align: center;
  color: #888;
  padding: 40px 0;
}
